{
  "name": "@react-native-seoul/kakao-login",
  "version": "6.0.3",
  "description": "React Native Module for Kakao Login",
  "main": "src/index",
  "types": "src/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -P ./plugins && flowgen src/index.d.ts -o src/index.js.flow",
    "lint": "eslint src plugins",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ./plugins",
    "validate": "yarn lint && yarn typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crossplatformkorea/react-native-kakao-login"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react-native",
    "kakao",
    "login",
    "kakao-login",
    "react-native-seoul",
    "dooboolab"
  ],
  "author": "dooboolab",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.6",
    "@react-native/eslint-config": "^0.86.2",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.0",
    "expo-module-scripts": "^5.0.8",
    "flowgen": "^1.21.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "typescript": "~5.9.3"
  }
}
